{
  "name": "oh-my-codes",
  "version": "4.3.0",
  "type": "module",
  "bin": {
    "oh-my-codes": "bin/omc.js",
    "omc": "bin/omc.js",
    "omcd": "bin/omcd.js"
  },
  "files": [
    "bin/omc.js",
    "bin/omcd.js"
  ],
  "scripts": {
    "build": "./scripts/build-binary.sh",
    "dev": "cargo run -p omc --",
    "dev:daemon": "cargo run -p omcd --",
    "test": "cargo test --workspace",
    "check": "cargo check --workspace",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint:fix": "cargo clippy --workspace --all-targets --fix -- -D warnings",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all --check"
  },
  "optionalDependencies": {
    "@y-square-t3/oh-my-codes-darwin-arm64": "workspace:*",
    "@y-square-t3/oh-my-codes-darwin-x64": "workspace:*",
    "@y-square-t3/oh-my-codes-linux-arm64": "workspace:*",
    "@y-square-t3/oh-my-codes-linux-x64": "workspace:*",
    "@y-square-t3/oh-my-codes-win32-x64": "workspace:*"
  }
}
